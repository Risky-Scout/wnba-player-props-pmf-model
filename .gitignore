*.log

*.egg-info/
src/*.egg-info/

# Stage 4+ model outputs and generated audits
data/model_outputs/
data/oof/

# CLV tracking data (large, regenerated nightly)
data/clv_tracking/

# Daily betting sheets and deliveries
deliveries/

# Generated diagnostic CSVs (regenerated by hotfix scripts)
artifacts/hotfix_diagnostics/*.csv

# Daily prediction distributions (generated by odds-scanner, regenerated nightly)
tools/odds-scanner/predictions/WNBA/Pre-Game/Distributions/*.json
pregame-latest/*/tools/odds-scanner/predictions/WNBA/Pre-Game/Distributions/*.json

# Injury data fetched at runtime
data/injuries/

# Forward snapshot data (soft-book quotes, availability accrual) — regenerated by
# cron, never commit raw data. Only board JSON artifacts are committed.
data/snapshots/
