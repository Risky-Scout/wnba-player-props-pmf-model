# WNBA Player Props PMF Model — Environment Template
# Copy to .env and fill in your values (never commit .env to git).

# BDL API Key (GOAT tier required for advanced stats, odds, player props, shot locations)
# Get yours at https://www.balldontlie.io/
# BDL_API_KEY and ODDS_API_KEY are INDEPENDENT credentials for different providers.
BDL_API_KEY=your_bdl_api_key_here

# The Odds API key (historical sportsbook player-prop lines / decision + closing snapshots)
# Get yours at https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# Hard fail-closed budget for historical Odds API backfill (credits). The backfill stops
# before any request that would exceed this. Historical event-odds cost = 10 x markets x regions.
ODDS_API_MAX_CREDITS=500000

# Season year (e.g. 2026 for the current WNBA season)
SEASON=2026

# Optional: override default output directories
# DELIVERIES_DIR=deliveries/today
# ARTIFACTS_DIR=artifacts
